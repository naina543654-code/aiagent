{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/journal-append.py\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "mcp__aipentester__*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-reminder.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}